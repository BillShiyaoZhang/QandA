---
import { questionPath } from '../lib/graph';
import { url, refUrl } from '../lib/view';
import type { Store } from '../lib/schema';
interface Props {
  s: Store;
  questionId: string;
  revisionId?: string;
}
const { s, questionId, revisionId } = Astro.props;
const nodes = questionPath(s, questionId, revisionId);
---

<nav class="breadcrumb" aria-label="当前探索路径">
  <a href={url('')}>问题档案</a>{
    nodes.map((n) => (
      <>
        <>
          <span aria-hidden="true">›</span>
          <a
            href={refUrl(s, n.kind, n.id)}
            title={n.kind === 'revision' ? s.questions[n.question_id].title : n.id}
          >
            {n.withdrawn
              ? '已撤回'
              : n.kind === 'revision'
                ? s.questions[n.question_id].title
                : `回答 ${n.id}`}
          </a>
        </>
      </>
    ))
  }
</nav>
