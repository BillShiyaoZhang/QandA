---
import { refTitle, refUrl, url } from '../lib/view';
import type { Store } from '../lib/schema';
interface Props {
  s: Store;
  nodeIds: string[];
}
const { s, nodeIds } = Astro.props;
const list = Object.values(s.relations).filter(
  (r) => nodeIds.includes(r.source_ref.entity_id) || nodeIds.includes(r.target_ref.entity_id),
);
const names = { related_topic: '主题相关', supports: '观点支持 →', conflicts_with: '观点冲突' };
const items = list.map((r) => {
  const fromCurrent = nodeIds.includes(r.source_ref.entity_id);
  const target = fromCurrent ? r.target_ref : r.source_ref;
  return {
    r,
    target,
    fromCurrent,
    label: refTitle(s, target.entity_type, target.entity_id),
    href:
      refUrl(s, target.entity_type, target.entity_id) + `?from=${encodeURIComponent(nodeIds[0])}`,
  };
});
const graph = items.slice(0, 20);
const height = Math.max(200, graph.length * 72 + 40);
const currentId=nodeIds[0];
const currentAnswer=s.answers[currentId];
const currentRevision=s.revisions[currentId];
const parentRef=currentAnswer?{kind:'revision',id:currentAnswer.question_revision_id}:currentRevision&&s.questions[currentRevision.question_id].parent_answer_id?{kind:'answer',id:s.questions[currentRevision.question_id].parent_answer_id!}:null;

---

<section class="section" aria-label="关联内容">
  <div class="section-title">
    <h2>关联内容 <span class="muted">{items.length}</span></h2><a
      class="small-text"
      href={url(`contribute/?kind=relation&source=${nodeIds[0]}`)}>建议关联 ↗</a>
  </div><p class="small-text muted">
    关联连接不同内容，不改变原来的追问路径。社区关联表达提交者的判断，不代表平台核实。
  </p>{
    !items.length ? (
      <p class="empty">还没有收录的关联。你可以提出一条连接及其理由。</p>
    ) : (
      <>
        {items.map(({ r, fromCurrent, label, href }, index) => (
          <article class="relation-card" data-relation-index={index} hidden={index >= 20}>
            <span class="relation-type">
              {names[r.type]}
              {r.type === 'supports' && !fromCurrent ? ' · 对方支持此处' : ''}
            </span>
            <h3>
              <a href={href}>{label.length > 75 ? label.slice(0, 75) + '…' : label}</a>
            </h3>
            <p>{r.rationale}</p>
            {r.source_excerpt && <blockquote>{r.source_excerpt}</blockquote>}
            {r.target_excerpt && <blockquote>{r.target_excerpt}</blockquote>}
            <span class="muted small-text">
              {r.decision === 'submitted' ? `社区提交：${r.proposed_by} · 自动收录，未经人工确认` : `关联确认：${r.decided_by} · ${r.decided_at?.slice(0, 10)}`}
            </span>
          </article>
        ))}
        {items.length > 20 && (
          <button class="button small" data-more-relations>
            显示更多关联
          </button>
        )}
        <details>
          <>
            <summary>查看局部关联图</summary>
            <div class="legend">
              <>
                <span>回答 / 追问路径</span>
                <span class="dashed">横向关联</span>
              </>
            </div>
            <svg
              class="relation-svg"
              viewBox={`0 0 640 ${height}`}
              role="img"
              aria-label="当前节点的一跳关联网络"
            >
              <defs><marker id="relation-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#729589" /></marker></defs>
              <rect x="14" y={height / 2 - 24} width="140" height="48" rx="8" fill="#e6f3ee" stroke="#75ae9d" />
              {parentRef && <><a href={refUrl(s,parentRef.kind,parentRef.id)}><rect x="14" y={height/2-100} width="140" height="42" rx="8" fill="white" stroke="#bcced0"/><text x="84" y={height/2-75} text-anchor="middle">{parentRef.kind==='answer'?'父答案':'当时的提问'}</text></a><path d={`M84 ${height/2-58} L84 ${height/2-25}`} fill="none" stroke="#729589" stroke-width="2" marker-end="url(#relation-arrow)"/></>}
              <text x="84" y={height / 2 + 5} text-anchor="middle">
                当前内容
              </text>
              {graph.map(({ r, label, href, fromCurrent }, i) => (
                <>
                  <path
                    d={`M154 ${height / 2} C250 ${height / 2} 260 ${i * 72 + 58} 328 ${i * 72 + 58}`}
                    fill="none"
                    stroke="#729589"
                    stroke-dasharray="5 4"
                    marker-end={
                      r.type === 'supports' && fromCurrent ? 'url(#relation-arrow)' : undefined
                    }
                    marker-start={
                      r.type === 'supports' && !fromCurrent ? 'url(#relation-arrow)' : undefined
                    }
                  />
                  <a href={href}>
                    <title>
                      {label} · {names[r.type]}
                    </title>
                    <rect
                      x="330"
                      y={i * 72 + 36}
                      width="295"
                      height="46"
                      rx="8"
                      fill="white"
                      stroke="#bcced0"
                    />
                    <text x="342" y={i * 72 + 55}>
                      {label.slice(0, 19)}
                      {label.length > 19 ? '…' : ''}
                    </text>
                    <text x="342" y={i * 72 + 73} style="font-size:11px;fill:#617381">
                      {names[r.type]}
                    </text>
                  </a>
                </>
              ))}
            </svg>
            <p class="small-text muted">最多显示 20 个邻居，完整关联可从上方链接列表继续阅读。</p>
          </>
        </details>
      </>
    )
  }
</section>
<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-more-relations]'))
    b.addEventListener('click', () => {
      const next = [
        ...b.parentElement!.querySelectorAll<HTMLElement>('[data-relation-index][hidden]'),
      ].slice(0, 20);
      next.forEach((n) => (n.hidden = false));
      if (!b.parentElement!.querySelector('[data-relation-index][hidden]')) b.hidden = true;
    });
</script>
