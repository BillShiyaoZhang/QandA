---
import Layout from '../../layouts/Layout.astro';
import { getContent, url } from '../../lib/view';
export function getStaticPaths() {
  return Object.values(getContent().questions)
    .filter((q) => !q.parent_answer_id)
    .map((q) => ({ params: { rootId: q.id }, props: { q } }));
}
const { q } = Astro.props;
---

<Layout title={`${q.title} · 探索树`} active="questions" wide
  ><div class="page-heading">
    <div>
      <div class="eyebrow">EXPLORATION / TREE</div><h1>{q.title}</h1><p class="muted small-text">
        实线目录保留对话的来路。选择一份回答，看看它引出了什么新问题。
      </p>
    </div><a class="button small" href={url(`questions/${q.id}/`)}>回到起始问题</a>
  </div><button
    class="button mobile-tree-toggle"
    id="mobile-tree"
    aria-expanded="false"
    aria-controls="tree-panel">查看分支目录</button
  ><div class="tree-layout" id="explorer" data-root={q.id} data-base={url('')}>
    <aside class="panel tree-panel" id="tree-panel">
      <div class="tree-tools">
        <button class="button small" id="locate-current">定位当前节点</button><button
          class="button small"
          id="collapse-tree">收起其他分支</button>
      </div><div id="tree-status" class="loading" role="status">正在加载探索路径…</div><ul
        class="tree-list"
        id="tree-list"
        aria-label="探索分支"
      >
      </ul><button class="button small tree-showmore" id="more-nodes" hidden>显示更多节点</button>
    </aside><section class="reading" id="tree-reading" aria-live="polite">
      <p class="loading">正在读取内容…</p>
    </section>
  </div><noscript
    ><div class="notice">
      分支图需要 JavaScript。你仍可以从<a href={url(`questions/${q.id}/`)}>起始问题</a
      >沿普通链接逐轮阅读。
    </div></noscript
  ></Layout
>
<script>
  const host = document.getElementById('explorer')!,
    root = host.dataset.root!,
    base = host.dataset.base!,
    list = document.getElementById('tree-list')!,
    reader = document.getElementById('tree-reading')!,
    status = document.getElementById('tree-status')!,
    more = document.getElementById('more-nodes') as HTMLButtonElement;
  type Node = {
    id: string;
    kind: string;
    label: string;
    parent: string | null;
    url: string;
    withdrawn: boolean;
  };
  let nodes: Node[] = [],
    map = new Map<string, Node>(),
    children = new Map<string, Node[]>(),
    expanded = new Set<string>(),
    focus = '',
    limit = 100,
    request = 0;
  const el = (tag: string, text?: string, className?: string) => {
    const n = document.createElement(tag);
    if (text) n.textContent = text;
    if (className) n.className = className;
    return n;
  };
  function expandPath(id: string) {
    let n = map.get(id);
    const seen = new Set<string>();
    while (n && !seen.has(n.id)) {
      seen.add(n.id);
      expanded.add(n.id);
      n = n.parent ? map.get(n.parent) : undefined;
    }
  }
  function renderTree() {
    list.replaceChildren();
    const flattened: { n: Node; depth: number }[] = [];
    const queue = (children.get('') || []).map((n) => ({ n, depth: 0 })).reverse();
    while (queue.length) {
      const item = queue.pop()!;
      flattened.push(item);
      if (expanded.has(item.n.id))
        for (const n of [...(children.get(item.n.id) || [])].reverse())
          queue.push({ n, depth: item.depth + 1 });
    }
    const focused = flattened.findIndex((x) => x.n.id === focus);
    let visible = flattened.slice(0, limit);
    if (focused >= limit) {
      const ancestorIds = new Set<string>();
      let n = map.get(focus);
      while (n) {
        ancestorIds.add(n.id);
        n = n.parent ? map.get(n.parent) : undefined;
      }
      visible = flattened.filter((x) => ancestorIds.has(x.n.id)).slice(-limit);
    }
    for (const { n, depth } of visible) {
      const li = el('li');
      const row = el('div', undefined, `tree-row ${n.kind}${n.id === focus ? ' current' : ''}`);
      row.id = `tree-${n.id}`;
      row.style.paddingLeft = `${6 + Math.min(depth, 5) * 10}px`;
      const has = (children.get(n.id) || []).length > 0;
      const b = document.createElement('button');
      b.textContent = has ? (expanded.has(n.id) ? '▾' : '▸') : '·';
      b.disabled = !has;
      if (has) {
        b.setAttribute('aria-expanded', String(expanded.has(n.id)));
        b.setAttribute('aria-label', `${expanded.has(n.id) ? '收起' : '展开'} ${n.label}`);
        b.addEventListener('click', () => {
          expanded.has(n.id) ? expanded.delete(n.id) : expanded.add(n.id);
          renderTree();
        });
      }
      const a = document.createElement('a');
      a.href = `?focus=${encodeURIComponent(n.id)}`;
      a.textContent = n.withdrawn ? '[已撤回]' : n.label;
      a.title = n.label;
      if (n.id === focus) a.setAttribute('aria-current', 'true');
      a.addEventListener('click', (e) => {
        e.preventDefault();
        select(n.id, true);
      });
      const kind = el(
        'span',
        ({ question: '问', revision: '版', answer: '答' } as Record<string, string>)[n.kind],
        'tree-kind',
      );
      row.append(b, kind, a);
      li.append(row);
      list.append(li);
    }
    more.hidden = flattened.length <= visible.length;
    status.hidden = true;
  }
  function link(text: string, href: string, cls = 'button small') {
    const a = document.createElement('a');
    a.textContent = text;
    a.href = href;
    a.className = cls;
    return a;
  }
  async function select(id: string, push = false) {
    if (!map.has(id)) {
      reader.replaceChildren(
        el('p', '链接中的节点不属于这棵探索树。', 'error'),
        link('回到起始问题', `${base}questions/${root}/`),
      );
      return;
    }
    focus = id;
    expandPath(id);
    renderTree();
    if (push) {
      history.pushState({}, '', `?focus=${encodeURIComponent(id)}`);
      if (matchMedia('(max-width:700px)').matches) {
        document.getElementById('tree-panel')!.classList.remove('mobile-open');
        document.getElementById('mobile-tree')!.setAttribute('aria-expanded', 'false');
      }
    }
    const token = ++request;
    reader.replaceChildren(el('p', '正在读取内容…', 'loading'));
    try {
      const response = await fetch(`${base}data/nodes/${encodeURIComponent(id)}.json`);
      if (!response.ok) throw Error('内容暂时无法读取');
      const d = await response.json();
      if (token !== request) return;
      reader.replaceChildren();
      const crumbs = el('nav', undefined, 'breadcrumb');
      crumbs.setAttribute('aria-label', '当前探索路径');
      for (const n of d.path) {
        const item = map.get(n.id);
        if (item)
          crumbs.append(
            link(
              item.kind === 'revision' ? `提问 ${n.id}` : `回答 ${n.id}`,
              `?focus=${encodeURIComponent(n.id)}`,
              'path-link',
            ),
          );
      }
      crumbs.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          select(new URL(a.href).searchParams.get('focus')!, true);
        }),
      );
      reader.append(
        crumbs,
        el('div', d.answer ? '答案记录' : '问题', 'eyebrow'),
        el('h2', d.question.title),
      );
      if (d.answer)
        reader.append(
          el(
            'p',
            `${d.answer.is_example ? '开发样例' : d.answer.generation.display_name || '模型未知'} · ${d.answer.generation.generated_at || '生成时间未知'} · ${d.answer.context.visible_history_completeness === 'unknown' ? '生成上下文未知' : '上下文由提交者提供'}`,
            'muted small-text',
          ),
        );
      if (d.withdrawn)
        reader.append(el('p', '此内容已撤回，位置保留以便继续阅读后续追问。', 'notice warning'));
      else {
        const body = el('div', undefined, 'prose');
        body.innerHTML = d.html;
        reader.append(body);
      }
      const actions = el('div', undefined, 'actions');
      actions.append(link('打开完整记录 ↗', d.url));
      if (!d.archived && !d.withdrawn)
        actions.append(
          link(
            d.answer ? '＋ 追问这份回答' : '提交本题答案',
            d.answer
              ? `${base}contribute/?kind=follow-up&parent=${id}`
              : `${base}contribute/?kind=answer&revision=${d.revision.id}`,
          ),
        );
      const copy = document.createElement('button');
      copy.className = 'button small';
      copy.textContent = '复制当前路径';
      const details = document.createElement('details'),
        summary = el('summary', '查看路径文本'),
        pre = el('pre', d.copy.text);
      details.append(summary, pre);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(d.copy.text);
          copy.textContent = '已复制';
        } catch {
          details.open = true;
          copy.textContent = '请在下方手动复制';
        }
      });
      actions.append(copy);
      reader.append(actions, details);
      if (!d.answer && d.answers.length) {
        reader.append(el('h3', '这一版的回答', 'section'));
        for (const a of d.answers)
          reader.append(
            link(`${a.name} · ${a.id}`, `?focus=${encodeURIComponent(a.id)}`, 'recent-item'),
          );
      }
      if (d.answer && d.followups.length) {
        reader.append(el('h3', '从这份回答继续', 'section'));
        for (const q of d.followups)
          reader.append(link(q.title, `?focus=${encodeURIComponent(q.id)}`, 'recent-item'));
      }
      for (const a of reader.querySelectorAll<HTMLAnchorElement>('.recent-item'))
        a.addEventListener('click', (e) => {
          e.preventDefault();
          select(new URL(a.href).searchParams.get('focus')!, true);
        });
    } catch (e) {
      if (token === request)
        reader.replaceChildren(
          el('p', e instanceof Error ? e.message : '读取失败', 'error'),
          link('打开问题页面', `${base}questions/${root}/`),
        );
    }
  }
  fetch(`${base}data/trees/${root}.json`)
    .then((r) => {
      if (!r.ok) throw Error();
      return r.json();
    })
    .then((data) => {
      nodes = data.nodes;
      map = new Map(nodes.map((n) => [n.id, n]));
      for (const n of nodes) {
        const key = n.parent || '';
        children.set(key, [...(children.get(key) || []), n]);
      }
      expanded.add(root);
      select(new URLSearchParams(location.search).get('focus') || root);
    })
    .catch(() => {
      status.textContent = '分支目录读取失败，请从起始问题继续浏览。';
      reader.replaceChildren(link('打开起始问题', `${base}questions/${root}/`));
    });
  document.getElementById('locate-current')!.addEventListener('click', () => {
    expandPath(focus);
    renderTree();
    document.getElementById(`tree-${focus}`)?.scrollIntoView({ block: 'nearest' });
  });
  document.getElementById('collapse-tree')!.addEventListener('click', () => {
    expanded = new Set();
    expandPath(focus);
    limit = 100;
    renderTree();
  });
  more.addEventListener('click', () => {
    limit += 100;
    renderTree();
  });
  document.getElementById('mobile-tree')!.addEventListener('click', () => {
    const panel = document.getElementById('tree-panel')!;
    const open = panel.classList.toggle('mobile-open');
    document.getElementById('mobile-tree')!.setAttribute('aria-expanded', String(open));
  });
  window.addEventListener('popstate', () =>
    select(new URLSearchParams(location.search).get('focus') || root),
  );
</script>
