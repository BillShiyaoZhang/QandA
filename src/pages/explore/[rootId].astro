---
import Layout from '../../layouts/Layout.astro';
import ExplorationView from '../../components/ExplorationView.astro';
import { getContent } from '../../lib/view';
export function getStaticPaths() {
  return Object.values(getContent().questions).filter((q) => !q.parent_answer_id)
    .map((q) => ({ params: { rootId: q.id }, props: { q } }));
}
const { q } = Astro.props;
---
<Layout title={`${q.title} · 分支探索`} active="questions" wide><ExplorationView questionId={q.id} /></Layout>
