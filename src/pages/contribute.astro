---
import Layout from '../layouts/Layout.astro';
import { getContent, github, issueLink } from '../lib/view';
import { contributionTargets } from '../lib/contribution';
const targets = contributionTargets(getContent());
---

<Layout title="分享问题与回答" active="contribute">
  <div class="page-heading">
    <div><div class="eyebrow">FOLLOW YOUR CURIOSITY</div><h1>让问题继续</h1>
      <p class="muted">一个好奇的问题，一点自己的想法，都值得分享。</p>
    </div>
  </div>
  <div class="detail-grid">
    <section class="reading">
      <form id="contribution-form" data-github={github} data-targets={JSON.stringify(targets)}>
        <div class="field">
          <label for="contribution-kind">想分享什么？</label>
          <select id="contribution-kind" name="kind">
            <option value="question">一个新问题</option>
            <option value="answer">一份回答</option>
            <option value="follow-up">接着一份回答追问</option>
            <option value="relation">两段内容之间的关联</option>
          </select>
        </div>
        <div id="kind-description" class="notice">只需写下想问的事，不用另起标题。也可以顺手附上已有回答。</div>
        <div class="field" id="target-field" hidden>
          <label for="contribution-target" id="target-label">选择内容</label>
          <select id="contribution-target" name="target"></select>
          <small>从问题或回答页面进入时，会自动选好位置。</small>
        </div>
        <div id="contribution-context" class="notice" role="status" hidden></div>
        <div class="field" id="second-target-field" hidden>
          <label for="second-target">另一段内容</label>
          <select id="second-target" name="second_target"></select>
        </div>
        <div id="second-context" class="notice" role="status" hidden></div>
        <p id="contribution-status" role="status" class="small-text muted"></p>
        <p class="form-note">下一步在 GitHub 写正文并提交，需要 GitHub 账号。内容会公开，提交时确认一次即可。</p>
        <button id="contribution-submit" class="button primary" type="submit">去写问题 ↗</button>
        <p class="small-text muted" style="margin-top:14px">来源补充可以留空，不用查模型版本、日期或参数。</p>
      </form>
      <noscript><p class="notice">可以直接<a href={issueLink('new-question')}>去 GitHub 写问题</a>，或启用 JavaScript 选择回答、追问与关联的位置。</p></noscript>
    </section>
    <aside>
      <div class="sidebar-card">
        <h2>你只需要带来内容</h2>
        <p class="small-text">提问不必先有答案。回答可以是自己的思考，也可以是已有的 AI 回答。</p>
        <p class="small-text muted">署名取自 GitHub 账号，投稿位置与记录时间由系统保存。知道来源时，在选填说明里补充即可。</p>
      </div>
      <div class="sidebar-card">
        <h2>提交之后</h2>
        <p class="small-text">系统检查后自动收录，通常几分钟后能在网站看到。需要补充时会在原投稿说明，修改后自动重试。</p>
        <a href={`${github}/issues`} class="small-text">查看投稿进度 ↗</a>
      </div>
    </aside>
  </div>
  <section class="section reading" id="rules">
    <details>
      <summary>公开分享与内容说明</summary>
      <div class="prose">
        <p>投稿会先在 GitHub 公开，通过格式和引用检查后自动进入网站。请只提交有权公开的内容，不要包含私人聊天、密钥或个人敏感信息。</p>
        <p>问题和追问的第一行用作展示标题，完整正文会保留。分享已有回答时，请保留原意；来源、实际提问与背景可以写在选填说明中，分享链接不能取代回答正文。</p>
        <p>回答固定在当时的问题版本，追问接着具体回答展开。关联默认表达主题相关；如选择观点支持或冲突，需要提供双方原文片段与理由。</p>
        <p>每条投稿只自动收录一次。收录后编辑 Issue 不会覆盖网站原文；新回答或追问请另行提交，更正与撤回可在原投稿说明。收录不代表事实核验。</p>
        <p>提交时确认允许本项目保留署名、公开展示、保存与必要格式整理；这不改变第三方材料原有权利。未提供的模型、生成时间和上下文保持未知，不根据署名推测内容作者或生成来源。</p>
      </div>
    </details>
  </section>
</Layout>
<script>
  import type { ContributionTarget } from '../lib/contribution';
  const form = document.getElementById('contribution-form') as HTMLFormElement;
  const kind = document.getElementById('contribution-kind') as HTMLSelectElement;
  const target = document.getElementById('contribution-target') as HTMLSelectElement;
  const second = document.getElementById('second-target') as HTMLSelectElement;
  const button = document.getElementById('contribution-submit') as HTMLButtonElement;
  const status = document.getElementById('contribution-status')!;
  const targets: ContributionTarget[] = JSON.parse(form.dataset.targets!);
  const params = new URLSearchParams(location.search);
  const options: Record<string, { template: string; label: string; description: string; button: string; type?: string; key?: string }> = {
    question: { template: 'new-question', label: '', description: '只需写下想问的事，不用另起标题。也可以顺手附上已有回答。', button: '去写问题' },
    answer: { template: 'submit-answer', label: '想回答哪个问题？', description: '写下自己的想法，或粘贴一份已有回答。知道来源时顺手说明，不清楚就留空。', button: '去写回答', type: 'revision', key: 'question_revision_id' },
    'follow-up': { template: 'follow-up', label: '想接着哪份回答问？', description: '哪一点让你想继续问下去？写下追问即可，也可以附上自己的初步回答。', button: '去写追问', type: 'answer', key: 'parent_answer_id' },
    relation: { template: 'suggest-relation', label: '从哪段内容开始？', description: '选好两段内容，下一步说说它们为什么有关。主题相关无需摘录原文；支持或冲突需要双方证据。', button: '去说明关联', key: 'source_id' },
  };
  if (options[params.get('kind') || '']) kind.value = params.get('kind')!;
  function populate(select: HTMLSelectElement, items: ContributionTarget[], selected = '') {
    select.replaceChildren(new Option('请选择…', ''));
    for (const item of items) select.add(new Option(item.label, item.id));
    select.value = items.some((item) => item.id === selected) ? selected : '';
  }
  function showContext(select: HTMLSelectElement, boxId: string) {
    const box = document.getElementById(boxId)!;
    const item = targets.find((item) => item.id === select.value);
    box.replaceChildren();
    box.hidden = !item || kind.value === 'question' || (boxId === 'second-context' && kind.value !== 'relation');
    if (box.hidden || !item) return;
    const title = document.createElement('strong'); title.textContent = item.title;
    const text = document.createElement('p');
    text.textContent = `${kind.value === 'follow-up' ? '针对这份回答继续追问' : item.kind === 'revision' ? '已选问题版本' : '已选回答'}：${item.excerpt}`;
    const link = document.createElement('a');
    link.href = `${import.meta.env.BASE_URL}${item.path}`;
    link.textContent = '查看这段内容 ↗';
    box.append(title, text, link);
  }
  function refreshSelection() {
    showContext(target, 'contribution-context');
    if (kind.value === 'relation') populate(second, targets.filter((item) => item.id !== target.value), second.value);
    showContext(second, 'second-context');
    button.disabled = !!options[kind.value].key && (!target.value || (kind.value === 'relation' && !second.value));
  }
  function update(selected = '', other = '') {
    const o = options[kind.value];
    document.getElementById('target-field')!.hidden = !o.key;
    document.getElementById('target-label')!.textContent = o.label;
    document.getElementById('second-target-field')!.hidden = kind.value !== 'relation';
    document.getElementById('kind-description')!.textContent = o.description;
    button.textContent = o.button + ' ↗';
    target.required = !!o.key;
    second.required = kind.value === 'relation';
    const available = targets.filter((item) => (!o.type || item.kind === o.type) && (kind.value === 'relation' || !item.archived));
    populate(target, available, selected);
    populate(second, targets.filter((item) => item.id !== target.value), other);
    status.textContent = o.key && !available.length ? '暂时没有可选择的内容。可以先分享一个新问题。' : o.key && selected && !target.value ? '原位置不存在、已归档或已撤回，请重新选择。' : kind.value === 'relation' && targets.length < 2 ? '至少需要两段可用内容才能建立关联。' : '';
    refreshSelection();
  }
  target.addEventListener('change', () => { status.textContent = ''; refreshSelection(); });
  second.addEventListener('change', refreshSelection);
  kind.addEventListener('change', () => update());
  update(params.get('revision') || params.get('parent') || params.get('source') || '', params.get('target') || '');
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (button.disabled || !form.reportValidity()) return;
    const o = options[kind.value];
    const u = new URL(form.dataset.github! + '/issues/new');
    u.searchParams.set('template', o.template + '.yml');
    const position = (id: string) => new URL(`${import.meta.env.BASE_URL}${targets.find((item) => item.id === id)!.path}`, location.origin).toString();
    if (o.key) u.searchParams.set(o.key, position(target.value));
    if (kind.value === 'relation') u.searchParams.set('target_id', position(second.value));
    location.assign(u.toString());
  });
</script>
