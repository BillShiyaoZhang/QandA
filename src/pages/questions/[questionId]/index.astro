---
import Layout from '../../../layouts/Layout.astro';
import ExplorationView from '../../../components/ExplorationView.astro';
import { getContent } from '../../../lib/view';
export function getStaticPaths() {
  return Object.values(getContent().questions).map((q) => ({
    params: { questionId: q.id },
    props: { q },
  }));
}
const { q } = Astro.props;
---

<Layout title={q.title} active="questions" wide><ExplorationView questionId={q.id} indexable /></Layout>
